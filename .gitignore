# Only the maintained workspace belongs in this repository. Everything else at
# the root (archives, model downloads, recordings, old repositories, IDE state,
# credentials and generated environments/builds) stays local by default.
/*
!/.gitignore
!/.gitattributes
!/.clang-format
!/.clang-tidy
!/README.md
!/THIRD_PARTY_NOTICES.md
!/pixi.toml
!/pixi.lock
!/colcon_defaults.yaml
!/scripts/
!/docs/
!/python/
!/environments/
/environments/*
!/environments/models/
/environments/models/*
!/environments/models/README.md
!/environments/models/pyproject.toml
!/environments/models/uv.lock
!/environments/models/act-public.json
!/external/
/external/*
!/external/robot_runtime/
!/src/
/src/*
!/src/robot_server/
!/src/model_client/
!/src/robot_recorder/
!/src/robot_teleop/
!/src/robot_examples/
!/src/robot_bringup/

# Generated files and local state, including within maintained directories.
**/.git/
**/.pixi/
**/.venv/
**/.dependencies/
**/build/
**/install/
**/log/
**/runs/
**/.cache/
**/.ruff_cache/
**/.pytest_cache/
**/.idea/
**/.vscode/
**/__pycache__/
**/*.egg-info/
.DS_Store
*.py[cod]
*.so
*.dylib
*.a
*.o
*.log
*.bak
*.swp

# Learned weights, training state, recorded data and large exports.
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.pickle
*.mcap
*.bag
*.db3
*.parquet
*.arrow
*.mp4
*.mov
*.zip
*.tar
*.tar.gz

# Credentials and private cloud connection details, wherever they are stored.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
**/.ssh/
**/.aws/
**/credentials*
**/secrets.*
**/attachment.json
