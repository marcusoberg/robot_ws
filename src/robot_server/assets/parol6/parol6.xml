<mujoco model="PAROL6">
  <compiler angle="radian" autolimits="true" meshdir="meshes"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicit"/>
  <statistic center="0 0 0.2" extent="0.75"/>
  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7"/>
    <global azimuth="135" elevation="-25"/>
  </visual>
  <asset>
    <!-- Arm visual assets and local transforms follow parol6.urdf. -->
    <mesh name="base_visual" file="base_link.STL"/>
    <mesh name="L1_visual" file="L1.STL"/>
    <mesh name="L2_visual" file="L2.STL"/>
    <mesh name="L3_visual" file="L3.STL"/>
    <mesh name="L4_visual" file="L4.STL"/>
    <mesh name="L5_visual" file="L5.STL"/>
    <mesh name="L6_visual" file="L6.STL"/>
    <mesh name="tool_body_visual" file="pneumatic_gripper_vertical_body_simplified.stl"/>
    <material name="robot_material" rgba="0.752941 0.752941 0.752941 1"/>
    <material name="tool_material" rgba="0.28 0.3 0.33 1"/>
  </asset>
  <include file="actuators.xml"/>
  <default>
    <joint damping="0.06" armature="0.001"/>
    <geom friction="0.8 0.02 0.002" condim="3"/>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="2" material="robot_material"/>
    </default>
    <default class="collision">
      <geom group="3" rgba="0.4 0.6 0.8 0.3"/>
    </default>
  </default>
  <worldbody>
    <camera name="overview" pos="0.75 -0.75 0.65" xyaxes="0.707107 0.707107 0 -0.301511 0.301511 0.904534" fovy="45"/>
    <geom name="floor" type="plane" size="1 1 0.05" pos="0 0 -0.015"/>
    <!-- Raised supports, 14 mm cube and an open container. The cube fits
         the existing 12..15.5 mm asymmetric pneumatic jaw opening. -->
    <geom name="cube_support" type="box" pos="0.22 -0.075 0.0175" size="0.025 0.025 0.0325" rgba="0.3 0.35 0.4 1"/>
    <body name="cube" pos="0.22 -0.075 0.057">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.007 0.007 0.007" mass="0.005"
            rgba="0.15 0.85 0.20 1" friction="1.5 0.01 0.001" condim="4"/>
    </body>
    <body name="container" pos="0.22 0.08 0.05">
      <geom name="container_support" type="box" pos="0 0 -0.0325" size="0.04 0.04 0.0325" rgba="0.3 0.35 0.4 1"/>
      <geom name="container_bottom" type="box" pos="0 0 0.003" size="0.04 0.04 0.003" rgba="0.65 0.38 0.18 1"/>
      <geom name="container_left" type="box" pos="-0.037 0 0.018" size="0.003 0.04 0.018" rgba="0.65 0.38 0.18 1"/>
      <geom name="container_right" type="box" pos="0.037 0 0.018" size="0.003 0.04 0.018" rgba="0.65 0.38 0.18 1"/>
      <geom name="container_front" type="box" pos="0 -0.037 0.018" size="0.034 0.003 0.018" rgba="0.65 0.38 0.18 1"/>
      <geom name="container_back" type="box" pos="0 0.037 0.018" size="0.034 0.003 0.018" rgba="0.65 0.38 0.18 1"/>
    </body>
    <!-- Match the URDF world-to-base_link mounting rotation. -->
    <body name="base" euler="0 0 -1.5707963267948966">
      <inertial pos="-0.0274562 -0.00137265 0.0312379" mass="0.812661"
                fullinertia="0.00110740 0.00106582 0.00147883 0.0000467463 0.00000847874 -0.00000261941"/>
      <geom class="visual" mesh="base_visual"/>
      <geom class="collision" type="cylinder" size="0.070 0.045" pos="0 0 0.045"/>
      <body name="L1" pos="0 0 0.1105">
        <joint name="L1" axis="0 0 1" range="-2.1475731 2.1475731" class="drive_L1"/>
        <inertial pos="0.0052453 0.0289723 0.0992791" mass="0.644801"
                  fullinertia="0.00109429 0.000569962 0.00129488 -0.0000627157 -0.0000570467 -0.000121686"/>
        <geom class="visual" mesh="L1_visual"/>
        <geom class="collision" type="capsule" fromto="0 0 0 0.02 0.02 0.13" size="0.035"/>
        <body name="L2" pos="0.0234207210610375 0 0" euler="-1.57079632679 0 0">
          <joint name="L2" axis="0 0 1" range="-2.530881 -0.05890486" class="drive_L2"/>
          <inertial pos="-0.00941816 -0.0783880 0.0369430" mass="0.512335"
                    fullinertia="0.00123357 0.000205463 0.00132225 0.00000363236 -0.000000330835 0.000000486442"/>
          <geom class="visual" mesh="L2_visual"/>
          <geom class="collision" type="capsule" fromto="0 0 0 0.18 0 0" size="0.028"/>
          <body name="L3" pos="0.18 0 0" euler="3.14159265359 0 0">
            <joint name="L3" axis="0 0 1" range="1.88261685 5.02423568" class="drive_L3"/>
            <inertial pos="0.0155510 -0.0191128 -0.00153323" mass="0.550971"
                      fullinertia="0.000578276 0.000567012 0.000815862 0.000116505 -0.0000119955 0.0000155814"/>
            <geom class="visual" mesh="L3_visual"/>
            <geom class="collision" type="capsule" fromto="0 0 0 -0.0435 0.17635 0" size="0.030"/>
            <body name="L4" pos="-0.0435 0.17635 0" euler="1.57079632679 0 0">
              <joint name="L4" axis="0 0 1" range="-1.8407944 1.8407944" class="drive_L4"/>
              <inertial pos="0.000947028 -0.00897895 -0.0924799" mass="0.393464"
                        fullinertia="0.000371673 0.000332364 0.000250607 -0.0000105560 -0.000000156899 -0.0000610397"/>
              <geom class="visual" mesh="L4_visual"/>
              <geom class="collision" type="capsule" fromto="0 0 0 0 0 -0.095" size="0.026"/>
              <body name="L5" euler="-1.57079632679 0 0">
                <joint name="L5" axis="0 0 1" range="-1.57079632679 1.57079632679" class="drive_L5"/>
                <inertial pos="0.000006716 -0.00621421 -0.000960871" mass="0.185172"
                          fullinertia="0.000109177 0.0000841308 0.000110629 -0.000000127195 0.000000084436 -0.000000441596"/>
                <geom class="visual" mesh="L5_visual"/>
                <geom class="collision" type="cylinder" size="0.030 0.035" euler="1.57079632679 0 0"/>
                <body name="L6" pos="0 0.037 0" euler="1.57079632679 0 0">
                  <joint name="L6" axis="0 0 1" range="0 6.28318530718" class="drive_L6"/>
                  <inertial pos="0.00632955 -0.000453856 -0.0764442" mass="0.0703261"
                            fullinertia="0.0000140276 0.0000181407 0.0000234608 0.000000315503 -0.000000928470 -0.000000943630"/>
                  <geom class="visual" mesh="L6_visual" pos="0 0 -0.021"/>
                  <geom class="visual" mesh="tool_body_visual" material="tool_material"/>
                  <!-- Contact pads are rendered directly so the image shows the
                       actual asymmetric jaw aperture, not two static CAD jaws. -->
                  <geom name="fixed_finger" type="box" pos="-0.055 -0.012 -0.027"
                        size="0.025 0.006 0.005" rgba="0.28 0.3 0.33 1" friction="1.5 0.01 0.001" condim="4"/>
                  <geom class="collision" type="cylinder" size="0.022 0.040"/>
                  <site name="tool_tcp" pos="-0.055 0 -0.027" size="0.004" rgba="0.1 0.8 0.2 1"/>
                  <body name="pneumatic_jaw" pos="-0.055 0 -0.027">
                    <joint name="gripper_slide" type="slide" axis="0 1 0" range="0 0.0035" damping="8"/>
                    <geom name="moving_finger" type="box" size="0.025 0.006 0.005" pos="0 0.012 0" rgba="0.28 0.3 0.33 1" friction="1.5 0.01 0.001" condim="4"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <!-- Primitive envelopes overlap at the base bearing and shared wrist axes.
         Exclude those assembly pairs; otherwise the solver pushes the arm away
         from its commanded pose even in free space. Other pairs and floor
         contacts remain enabled. This coarse twin is not a collision model
         of the CAD assembly. -->
    <exclude body1="base" body2="L1"/>
    <exclude body1="base" body2="L2"/>
    <exclude body1="L1" body2="L3"/>
    <exclude body1="L3" body2="L5"/>
    <exclude body1="L3" body2="L6"/>
    <exclude body1="L4" body2="L6"/>
    <!-- The coarse jaw box also intersects the wrist envelope when it bends. -->
    <exclude body1="L4" body2="pneumatic_jaw"/>
  </contact>
  <actuator>
    <position name="L1_position" joint="L1" class="drive_L1"/>
    <position name="L2_position" joint="L2" class="drive_L2"/>
    <position name="L3_position" joint="L3" class="drive_L3"/>
    <position name="L4_position" joint="L4" class="drive_L4"/>
    <position name="L5_position" joint="L5" class="drive_L5"/>
    <position name="L6_position" joint="L6" class="drive_L6"/>
    <position name="gripper_position" joint="gripper_slide" kp="200"/>
  </actuator>
</mujoco>
