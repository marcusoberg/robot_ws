uint8 ENABLE=0
uint8 DISABLE=1
uint8 STOP=2
uint8 HOLD=3
uint8 STANDBY=4
uint8 OPEN_GRIPPER=5
uint8 CLOSE_GRIPPER=6
uint8 SELECT=7
uint8 RELEASE=8
uint8 TAKEOVER=9
uint8 STATUS=10
uint8 action
string source
string source_instance
# Caller UUID makes retries idempotent; a new request needs a fresh UUID.
string request_key
