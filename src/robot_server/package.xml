  <exec_depend>rosgraph_msgs</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>robot_description</exec_depend><exec_depend>robot_data</exec_depend>
