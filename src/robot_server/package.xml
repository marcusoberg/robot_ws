<?xml version="1.0"?>
<package format="3">
  <name>robot_server</name><version>2.0.0</version>
  <description>Execution owner, simulation application, and ROS joint-goal interface.</description>
  <maintainer email="team@example.invalid">Robot team</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend><buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend><exec_depend>rosidl_default_runtime</exec_depend>
