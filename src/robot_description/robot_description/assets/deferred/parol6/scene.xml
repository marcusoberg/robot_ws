<mujoco model="PAROL6 pick and place">
  <include file="parol6.xml"/>
  <include file="../../pick_place.xml"/>
  <statistic center="0.19 0.13 0.15" extent=".55"/>
  <worldbody>
    <!-- SO101 world-axis offset from its base, scaled by 1.3 in XY. -->
    <body name="container" pos="-0.13 0.286 0">
      <include file="../../container.xml"/>
    </body>
    <!-- Same world-axis offset from the robot base as the SO101 front camera. -->
    <camera name="front" pos="0.1200 0.5200 0.2600" quat="0.138452 0.058333 0.383862 0.911086" fovy="65" />
    <camera name="top" pos="0.05 0.20 0.65" quat="1 0 0 0" fovy="60" />
    <!-- Same XY offset from the base as SO101: (0.27, 0.20) - (0.20, -0.12).
         The 14 mm cube fits the existing 12..15.5 mm pneumatic jaw opening. -->
    <geom class="scene_geom" name="cube_support" type="box" pos="0.07 0.32 0.025" size="0.025 0.025 0.025" rgba="0.3 0.35 0.4 1"/>
    <body name="block" pos="0.07 0.32 0.057" quat="0.9975640502598242 0 0 -0.0697564737441253">
      <freejoint name="cube_free"/>
      <geom name="block" type="box" size="0.007 0.007 0.007" mass="0.005"
            rgba="0.15 0.85 0.20 1" friction="1.5 0.01 0.001" condim="4"/>
    </body>
  </worldbody>
</mujoco>
