# Discover MuJoCo independently of the communication adapter and IDE.
if(NOT ROBOT_RUNTIME_NATIVE_SDK_ACTIVE)
    find_package(mujoco CONFIG QUIET)
endif()
if(NOT TARGET mujoco::mujoco)
    find_package(Python3 COMPONENTS Interpreter QUIET)
    if(ROBOT_RUNTIME_NATIVE_SDK_ACTIVE)
        set(mujoco_python "${ROBOT_RUNTIME_SDK_PYTHON}")
    else()
        set(mujoco_python "${Python3_EXECUTABLE}")
    endif()
    if(mujoco_python)
        execute_process(COMMAND "${mujoco_python}" -c
            "import pathlib, mujoco; print(pathlib.Path(mujoco.__file__).resolve().parent)"
            OUTPUT_VARIABLE MUJOCO_WHEEL OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    endif()
    # With the managed SDK, never pair wheel headers with a system MuJoCo library.
    if(ROBOT_RUNTIME_NATIVE_SDK_ACTIVE)
        set(mujoco_search_options NO_DEFAULT_PATH)
    endif()
    find_path(MUJOCO_INCLUDE_DIR mujoco/mujoco.h HINTS "${MUJOCO_WHEEL}/include" ${mujoco_search_options})
    find_library(MUJOCO_LIBRARY NAMES mujoco HINTS "${MUJOCO_WHEEL}" ${mujoco_search_options})
    if(NOT MUJOCO_LIBRARY)
        file(GLOB MUJOCO_LIBRARIES "${MUJOCO_WHEEL}/libmujoco.so*" "${MUJOCO_WHEEL}/libmujoco*.dylib")
        if(MUJOCO_LIBRARIES)
            list(GET MUJOCO_LIBRARIES 0 MUJOCO_LIBRARY)
            set(MUJOCO_LIBRARY "${MUJOCO_LIBRARY}" CACHE FILEPATH "MuJoCo native library" FORCE)
        endif()
    endif()
    if(NOT MUJOCO_INCLUDE_DIR OR NOT MUJOCO_LIBRARY)
        message(FATAL_ERROR "MuJoCo requested but unavailable. Run scripts/setup_native.sh, set mujoco_DIR for a system installation (ROBOT_RUNTIME_USE_NATIVE_SDK=OFF), or set ROBOT_RUNTIME_BUILD_MUJOCO=OFF.")
    endif()
    get_filename_component(MUJOCO_PLUGIN_DIRECTORY "${MUJOCO_LIBRARY}" DIRECTORY)
    set(MUJOCO_PLUGIN_DIRECTORY "${MUJOCO_PLUGIN_DIRECTORY}/plugin")
    set(MUJOCO_LINK_LIBRARY "${MUJOCO_LIBRARY}")
    if(APPLE)
        execute_process(COMMAND otool -D "${MUJOCO_LIBRARY}" OUTPUT_VARIABLE MUJOCO_INSTALL_NAME)
        if(MUJOCO_INSTALL_NAME MATCHES "mujoco.framework")
            # Wheels flatten this framework while retaining its install name. Restore
            # that layout in the build, also satisfying plugin library dependencies.
            get_filename_component(MUJOCO_DYLIB_NAME "${MUJOCO_LIBRARY}" NAME)
            set(MUJOCO_FRAMEWORK_ROOT "${CMAKE_CURRENT_BINARY_DIR}/mujoco-native")
            set(MUJOCO_LINK_LIBRARY "${MUJOCO_FRAMEWORK_ROOT}/mujoco.framework/Versions/A/${MUJOCO_DYLIB_NAME}")
            configure_file("${MUJOCO_LIBRARY}" "${MUJOCO_LINK_LIBRARY}" COPYONLY)
        endif()
    endif()
    add_library(mujoco::mujoco UNKNOWN IMPORTED)
    set_target_properties(mujoco::mujoco PROPERTIES IMPORTED_LOCATION "${MUJOCO_LINK_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${MUJOCO_INCLUDE_DIR}")
endif()
