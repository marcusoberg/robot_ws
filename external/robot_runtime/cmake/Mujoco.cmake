if(NOT ROBOT_RUNTIME_WITH_PYTHON)
  find_package(mujoco 3.10 CONFIG QUIET)
endif()
if(NOT TARGET mujoco::mujoco)
  if(Python_EXECUTABLE)
    execute_process(COMMAND "${Python_EXECUTABLE}" -I -c
      "import importlib.util, pathlib; print(pathlib.Path(importlib.util.find_spec('mujoco').origin).parent)"
      OUTPUT_VARIABLE MUJOCO_WHEEL OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  endif()
  find_path(MUJOCO_INCLUDE_DIR mujoco/mujoco.h HINTS "${MUJOCO_WHEEL}/include" NO_DEFAULT_PATH)
  file(GLOB MUJOCO_LIBRARIES "${MUJOCO_WHEEL}/libmujoco.so*" "${MUJOCO_WHEEL}/libmujoco*.dylib")
  if(NOT MUJOCO_INCLUDE_DIR OR NOT MUJOCO_LIBRARIES)
    message(FATAL_ERROR "Install MuJoCo 3.10 or specify mujoco_DIR. Python builds may use the mujoco==3.10.0 wheel.")
  endif()
  list(GET MUJOCO_LIBRARIES 0 MUJOCO_LINK_LIBRARY)
  if(APPLE)
    get_filename_component(MUJOCO_DYLIB_NAME "${MUJOCO_LINK_LIBRARY}" NAME)
    set(MUJOCO_FRAMEWORK_ROOT "${CMAKE_CURRENT_BINARY_DIR}/mujoco-native")
    set(MUJOCO_FRAMEWORK_LIBRARY "${MUJOCO_FRAMEWORK_ROOT}/mujoco.framework/Versions/A/${MUJOCO_DYLIB_NAME}")
    configure_file("${MUJOCO_LINK_LIBRARY}" "${MUJOCO_FRAMEWORK_LIBRARY}" COPYONLY)
    set(MUJOCO_LINK_LIBRARY "${MUJOCO_FRAMEWORK_LIBRARY}")
  endif()
  add_library(mujoco::mujoco UNKNOWN IMPORTED)
  set_target_properties(mujoco::mujoco PROPERTIES IMPORTED_LOCATION "${MUJOCO_LINK_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${MUJOCO_INCLUDE_DIR}")
endif()
