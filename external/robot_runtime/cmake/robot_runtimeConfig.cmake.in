@PACKAGE_INIT@
set(_robot_runtime_prefix "${PACKAGE_PREFIX_DIR}")
cmake_policy(PUSH)
if(POLICY CMP0167)
    cmake_policy(SET CMP0167 NEW)
endif()
include(CMakeFindDependencyMacro)
# The source SDK uses its own explicit dependency installation.
list(PREPEND CMAKE_PREFIX_PATH "@sdk_prefix@" "@yaml-cpp_DIR@")
set(COAL_DISABLE_HPP_FCL_WARNINGS ON)
find_dependency(pinocchio 3.8.0 EXACT CONFIG)
find_dependency(Eigen3 CONFIG)
find_dependency(yaml-cpp CONFIG)
find_dependency(Threads)
find_dependency(ruckig 0.15.3 CONFIG)
if(@ROBOT_RUNTIME_BUILD_MUJOCO@ AND NOT TARGET mujoco::mujoco)
    add_library(mujoco::mujoco UNKNOWN IMPORTED)
    set_target_properties(mujoco::mujoco PROPERTIES IMPORTED_LOCATION "${_robot_runtime_prefix}/@ROBOT_RUNTIME_INSTALLED_MUJOCO@" INTERFACE_INCLUDE_DIRECTORIES "${_robot_runtime_prefix}/@CMAKE_INSTALL_INCLUDEDIR@")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/robot_runtimeTargets.cmake")
check_required_components(robot_runtime)
cmake_policy(POP)
